# Staging environment — copy to .env.staging and fill in values
# Copy real values from /opt/portfolio/.env on the VPS

# ── Postgres (local staging DB) ───────────────────────────────────────────────
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=                        # same as prod — min 32 chars
ADMIN_EMAIL=                       # same as prod
ADMIN_PASSWORD_HASH=               # same as prod

# ── Secrets ───────────────────────────────────────────────────────────────────
REVALIDATE_SECRET=                 # same as prod
TRANSCRIPT_SECRET=                 # same as prod — min 32 chars

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=                # same as prod
OPENAI_API_KEY=                    # same as prod (embeddings)
DEEPSEEK_API_KEY=                  # same as prod (unused if on OpenRouter)

# ── Voice ────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=                # same as prod
ELEVENLABS_AGENT_ID=               # same as prod

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                      # same as prod
GITHUB_USERNAME=HammadAfzalCode

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=             # same as prod
CLOUDINARY_API_KEY=                # same as prod
CLOUDINARY_API_SECRET=             # same as prod

# ── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=                    # same as prod
