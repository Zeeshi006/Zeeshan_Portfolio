# ── Deployment identity ───────────────────────────────────────────────────────
# Your GitHub username (lowercase) — used to resolve GHCR image names.
GITHUB_REPOSITORY_OWNER=hammadafzalcode

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
CADDY_EMAIL=you@example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=portfolio

# ── Public URLs (baked into the Next.js build at CI time) ────────────────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Secrets — generate each with: openssl rand -base64 48 ────────────────────
JWT_SECRET=CHANGE_ME
REVALIDATE_SECRET=CHANGE_ME

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_EMAIL=you@example.com
# Generate hash: node -e "require('bcrypt').hash('YourPassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=BCRYPT_HASH

# ── NestJS origin allowlist ───────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com

# ── WebAuthn passkeys ─────────────────────────────────────────────────────────
RP_ID=yourdomain.com
RP_ORIGIN=https://yourdomain.com

# ── LLM / AI ─────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=CHANGE_ME

# ── GitHub integration ────────────────────────────────────────────────────────
GITHUB_TOKEN=CHANGE_ME_NEW_PAT_READ_ONLY
GITHUB_USERNAME=HammadAfzalCode
GITHUB_CACHE_TTL_SECONDS=3600
